# Pipedrive OAuth App Credentials (from Developer Hub)
PIPEDRIVE_CLIENT_ID=your_pipedrive_client_id
PIPEDRIVE_CLIENT_SECRET=your_pipedrive_client_secret

# Supabase Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server Configuration
APP_BASE_URL=http://localhost:3000
PORT=3000